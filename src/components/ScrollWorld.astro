---
import { mobileTourSegments, tourSegments } from '../data/tour';
import { characterPrototypes, stopCharacters } from '../data/characters';
import { dialogues, visibleDialogueActions } from '../data/dialogues';
import { characterUrls, mobileLandscapeVideoUrls, mobilePortraitVideoUrls, photoUrls, posterUrls, videoUrls } from '../data/media';
import { createTourTimeline } from '../scripts/timeline';

const timeline = createTourTimeline(tourSegments);
const mobileTimeline = createTourTimeline(mobileTourSegments);
const stopSegments = timeline.segments.flatMap((segment, segmentIndex) => segment.stopUnits > 0 ? [{ segment, segmentIndex }] : []);
const characterLayers = stopSegments.flatMap(({ segment, segmentIndex }) => {
  const assignment = stopCharacters.find((entry) => entry.stopId === segment.stopId);
  const character = characterPrototypes.find((entry) => entry.id === assignment?.characterId);
  return character ? [{ segmentIndex, stopId: segment.stopId, character }] : [];
});
const dialogueLayers = stopSegments.flatMap(({ segment, segmentIndex }, stopIndex) => {
  const dialogue = dialogues.find((entry) => entry.stopId === segment.stopId);
  const character = characterLayers.find((entry) => entry.stopId === segment.stopId)?.character;
  return dialogue && character ? [{ segmentIndex, stopIndex, dialogue, character, actions: visibleDialogueActions(dialogue) }] : [];
});
const isDev = import.meta.env.DEV;
---

<section class="world" data-world style={`--desktop-world-height: ${100 * (timeline.totalUnits + 1)}svh; --mobile-world-height: ${100 * (mobileTimeline.totalUnits + 1)}svh`} aria-label="Recorrido visual de Sonríe">
  <div class="stage" data-stage>
    <div class="fallback" aria-hidden="true"></div>
    {timeline.segments.map((segment, index) => (
      <video
        class="clip"
        data-clip
        data-index={index}
        data-asset={segment.clipAsset}
        data-src={videoUrls[segment.clipAsset]}
        data-mobile-portrait-src={mobilePortraitVideoUrls[segment.clipAsset]}
        data-mobile-landscape-src={mobileLandscapeVideoUrls[segment.clipAsset]}
        preload="none"
        muted
        playsinline
        aria-hidden="true"
        tabindex="-1"
      />
    ))}
    {timeline.segments.map((segment, index) => segment.stopPhotoAsset && (
      <img
        class="stop-image"
        data-poster
        data-index={index}
        data-asset={segment.clipAsset}
        src={posterUrls[segment.clipAsset]}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    ))}
    {timeline.segments.map((segment, index) => segment.stopPhotoAsset && (
      <img
        class="stop-image"
        data-photo
        data-index={index}
        data-asset={segment.stopPhotoAsset}
        src={photoUrls[segment.stopPhotoAsset]}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    ))}
    <div class="shade" aria-hidden="true"></div>
    <canvas class="particles" data-particles data-active-stop="" aria-hidden="true"></canvas>
    {stopSegments.map(({ segment, segmentIndex }, stopIndex) => (
      <section
        class="stop"
        data-stop
        data-index={segmentIndex}
        data-stop-id={segment.stopId}
        aria-labelledby={`stop-title-${stopIndex + 1}`}
        hidden
      >
        <p class="stop-eyebrow">Parada del recorrido</p>
        <h3 id={`stop-title-${stopIndex + 1}`}>Parada {stopIndex + 1}</h3>
        <p>Contenido en preparación.</p>
      </section>
    ))}
    {characterLayers.map(({ segmentIndex, stopId, character }) => (
      <img
        class="character"
        data-character
        data-stop-index={segmentIndex}
        data-stop-id={stopId}
        data-asset={character.imageAsset}
        data-src={characterUrls[character.imageAsset]}
        alt=""
        aria-hidden="true"
        decoding="async"
      />
    ))}
    {dialogueLayers.map(({ segmentIndex, stopIndex, dialogue, character, actions }) => (
      <section
        class="dialogue"
        data-dialogue
        data-stop-index={segmentIndex}
        data-stop-id={dialogue.stopId}
        aria-label={`Diálogo de la parada ${stopIndex + 1}`}
        hidden
      >
        <p class="dialogue-eyebrow">Personaje ilustrativo · Prototipo</p>
        <h3>{character.displayLabel}</h3>
        <div class="dialogue-pages" aria-live="polite">
          {dialogue.pages.map((page, index) => <p data-dialogue-page data-page-index={index} hidden={index > 0}>{page}</p>)}
        </div>
        <div class="dialogue-controls" aria-label="Páginas del diálogo">
          <button type="button" data-dialogue-prev aria-label="Página anterior" disabled>Anterior</button>
          <span data-page-indicator aria-live="off">1 / {dialogue.pages.length}</span>
          <button type="button" data-dialogue-next aria-label="Siguiente página">Siguiente</button>
        </div>
        <a class="dialogue-skip" href="#despues-del-recorrido">Saltar el recorrido</a>
        {actions.length > 0 && <nav class="dialogue-actions" aria-label="Enlaces del perfil">{actions.map((action) => <a data-dialogue-action href={action.url} target="_blank" rel="noopener noreferrer">{action.label}</a>)}</nav>}
      </section>
    ))}
    <div class="copy">
      <p class="eyebrow">Recorrido en preparación · {timeline.segments.length} tramos</p>
      <h2>Conoce Sonríe</h2>
      <p data-status role="status" aria-live="polite">Cargando el primer tramo…</p>
      <a href="#despues-del-recorrido">Saltar el recorrido</a>
    </div>
    <div class="counter" aria-hidden="true"><span data-counter>01</span> / {String(timeline.segments.length).padStart(2, '0')}</div>
    <nav class="stops" aria-label="Navegar por el recorrido">
      <div class="timeline-rail" data-timeline-rail>
        <div class="timeline-slider" data-timeline-slider role="slider" tabindex="0" aria-label="Posición del recorrido" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="Inicio del recorrido">
          <span class="timeline-line" aria-hidden="true"></span>
          <span class="timeline-progress" aria-hidden="true"></span>
        </div>
        {stopSegments.map(({ segmentIndex }, stopIndex) => (
          <button
            type="button"
            data-goto-stop={segmentIndex}
            style={`--stop-desktop-position: ${100 * timeline.segments[segmentIndex].stopStart / timeline.totalUnits}%; --stop-mobile-position: ${100 * mobileTimeline.segments[segmentIndex].stopStart / mobileTimeline.totalUnits}%`}
            aria-label={`Ir a la parada ${stopIndex + 1}`}
          >
            {String(stopIndex + 1).padStart(2, '0')}
          </button>
        ))}
        <span class="timeline-indicator" aria-hidden="true"></span>
      </div>
    </nav>
    {isDev && (
      <label class="mode-picker" data-mode-picker hidden>
        Fondo de esta parada
        <select data-mode-select>
          <option value="video-freeze">Video congelado</option>
          <option value="poster-image">Póster del video</option>
          <option value="high-res-image">Foto homónima</option>
        </select>
      </label>
    )}
    {isDev && <output class="debug" data-debug aria-label="Depuración del recorrido">Iniciando recorrido…</output>}
  </div>
  <div class="static-dialogues" aria-label="Información del recorrido sin animación">
    {dialogueLayers.map(({ stopIndex, dialogue, character, actions }) => (
      <article data-static-dialogue>
        <h3>Parada {stopIndex + 1} · {character.displayLabel}</h3>
        {dialogue.pages.map((page) => <p>{page}</p>)}
        {actions.length > 0 && <nav aria-label="Enlaces del perfil">{actions.map((action) => <a data-dialogue-action href={action.url} target="_blank" rel="noopener noreferrer">{action.label}</a>)}</nav>}
      </article>
    ))}
  </div>
</section>

<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>

<style>
  .world { position: relative; height: var(--desktop-world-height); background: #173b40; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; color: white; background: #173b40; }
  .fallback, .clip, .stop-image, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fallback { background: radial-gradient(circle at 70% 30%, #337477, #173b40 70%); }
  .clip { object-fit: cover; opacity: 0; transition: opacity 180ms ease; }
  .clip.is-active, .clip.is-outgoing { opacity: 1; }
  .stop-image { object-fit: cover; object-position: center; opacity: 0; transition: opacity 180ms ease; pointer-events: none; }
  .stop-image.is-active, .stop-image.is-outgoing { opacity: 1; }
  .shade { z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgb(7 30 34 / 77%), transparent 80%), linear-gradient(0deg, rgb(7 30 34 / 65%), transparent 45%); }
  .particles { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; pointer-events: none; }
  .stop { position: absolute; z-index: 2; top: clamp(5rem, 12vh, 8rem); left: clamp(1.5rem, 6vw, 6rem); max-width: min(26rem, calc(100% - 6rem)); padding: 1.25rem 1.5rem; border: 1px solid rgb(255 255 255 / 50%); border-radius: 1rem; background: rgb(7 30 34 / 82%); box-shadow: 0 1rem 2rem rgb(0 0 0 / 15%); }
  .stop[hidden] { display: none; }
  .stop-eyebrow { margin: 0 0 .5rem; font-size: .75rem; letter-spacing: .15em; text-transform: uppercase; }
  .stop h3 { margin: 0 0 .5rem; font-size: clamp(1.5rem, 4vw, 2.25rem); }
  .stop p:last-child { margin: 0; }
  .character { position: absolute; z-index: 2; right: clamp(3.5rem, 7vw, 7rem); bottom: 0; max-width: min(45vw, 42rem); height: min(86svh, 56rem); object-fit: contain; object-position: bottom right; pointer-events: none; opacity: 0; visibility: hidden; transform: translateY(1.5rem); transition: opacity 240ms ease, transform 240ms ease, visibility 0s linear 240ms; }
  .character.is-visible { opacity: 1; visibility: visible; transform: translateY(0); transition: opacity 240ms ease, transform 240ms ease, visibility 0s; }
  .stage[data-dialogue-visible='true'] .stop:not([hidden]) { display: none; }
  .stage[data-dialogue-visible='true'] .copy { opacity: 0; visibility: hidden; pointer-events: none; }
  .dialogue { position: absolute; z-index: 3; left: clamp(1.5rem, 6vw, 6rem); bottom: clamp(1.5rem, 5vh, 3rem); width: min(35rem, calc(100% - 8rem)); padding: 1.25rem 1.5rem; border: 1px solid rgb(255 255 255 / 55%); border-radius: 1rem; background: rgb(7 30 34 / 89%); box-shadow: 0 1rem 2rem rgb(0 0 0 / 20%); backdrop-filter: blur(12px); }
  .dialogue[hidden] { display: none; }
  .dialogue-eyebrow { margin: 0 0 .4rem; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; }
  .dialogue h3 { margin: 0 0 .6rem; font-size: clamp(1rem, 2vw, 1.4rem); }
  .dialogue-pages p { margin: 0; line-height: 1.5; }
  .dialogue-pages p[hidden] { display: none; }
  .dialogue-controls { display: flex; align-items: center; gap: .75rem; margin-top: 1rem; }
  .dialogue-controls button, .dialogue-actions a { border: 1px solid rgb(255 255 255 / 70%); border-radius: 999px; padding: .45rem .8rem; background: transparent; color: white; cursor: pointer; font: inherit; }
  .dialogue-controls button:disabled { opacity: .45; cursor: default; }
  .dialogue-controls button:focus-visible, .dialogue-actions a:focus-visible { outline: 3px solid white; outline-offset: 3px; }
  [data-page-indicator] { font-variant-numeric: tabular-nums; font-size: .8rem; }
  .dialogue-skip { display: inline-block; margin-top: .75rem; font-size: .8rem; text-underline-offset: .2em; }
  .dialogue-skip:focus-visible { outline: 3px solid white; outline-offset: 3px; }
  .dialogue-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .static-dialogues { display: none; }
  .copy { position: absolute; z-index: 2; left: clamp(1.5rem, 6vw, 6rem); bottom: clamp(2.5rem, 9vh, 6rem); max-width: 34rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .15em; font-size: .75rem; }
  h2 { margin: .6rem 0; font-size: clamp(2.75rem, 7vw, 6rem); line-height: 1; }
  [data-status] { min-height: 1.5em; margin: 1.25rem 0; }
  a { display: inline-block; padding: .75rem 1rem; border: 1px solid currentColor; border-radius: 999px; text-underline-offset: .2em; }
  a:focus-visible { outline: 3px solid white; outline-offset: 4px; }
  .counter { position: absolute; z-index: 2; right: clamp(1.5rem, 6vw, 6rem); bottom: clamp(2.5rem, 9vh, 6rem); font-variant-numeric: tabular-nums; }
  .stops { position: absolute; z-index: 3; right: clamp(1rem, 3vw, 3rem); top: 50%; width: 2.75rem; height: min(68svh, 35rem); min-height: 18rem; padding-block: 1.375rem; box-sizing: border-box; border: 1px solid rgb(246 244 238 / 32%); border-radius: .35rem; background: rgb(14 25 28 / 76%); box-shadow: 0 .5rem 1.5rem rgb(0 0 0 / 18%); transform: translateY(-50%); }
  .timeline-rail { position: relative; width: 100%; height: 100%; --tour-progress: 0%; }
  .timeline-slider { position: absolute; inset: 0; z-index: 1; cursor: ns-resize; touch-action: none; }
  .timeline-slider:focus-visible { outline: 2px solid #f6f4ee; outline-offset: 3px; border-radius: .2rem; }
  .timeline-line, .timeline-progress { position: absolute; left: 50%; top: 0; width: 2px; transform: translateX(-50%); pointer-events: none; }
  .timeline-line { height: 100%; background: rgb(246 244 238 / 45%); }
  .timeline-progress { height: var(--tour-progress); background: #f6f4ee; }
  .timeline-indicator { position: absolute; z-index: 1; left: 50%; top: var(--tour-progress); width: 3.5rem; height: 3px; background: #f6f4ee; box-shadow: 0 0 0 1px rgb(14 25 28 / 85%); transform: translate(-50%, -50%); pointer-events: none; }
  .stops button { position: absolute; z-index: 2; left: 50%; top: var(--stop-desktop-position); display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; border: 0; background: transparent; color: #f6f4ee; cursor: pointer; touch-action: none; font: 600 .75rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; font-variant-numeric: tabular-nums; letter-spacing: .04em; transform: translate(-50%, -50%); }
  .stops button::before { position: absolute; z-index: -1; inset: .42rem .15rem; border: 1px solid rgb(246 244 238 / 67%); border-radius: .15rem; background: #19282b; content: ''; }
  .stops button[aria-current='step'] { color: #142124; }
  .stops button[aria-current='step']::before { border-color: #f6f4ee; background: #f6f4ee; }
  .stops button:focus-visible { outline: 2px solid #f6f4ee; outline-offset: 2px; }
  .debug { position: absolute; z-index: 3; left: 1rem; top: 1rem; max-width: calc(100% - 2rem); padding: .4rem .6rem; background: rgb(7 30 34 / 82%); color: white; font: .75rem/1.4 monospace; }
  .mode-picker { position: absolute; z-index: 4; top: 1rem; right: 1rem; padding: .4rem .6rem; background: rgb(7 30 34 / 82%); color: white; font: .75rem/1.4 sans-serif; }
  .mode-picker[hidden] { display: none; }
  .mode-picker select { display: block; margin-top: .25rem; padding: .25rem; border: 1px solid white; border-radius: .25rem; background: #173b40; color: white; }
  .mode-picker select:focus-visible { outline: 3px solid white; outline-offset: 3px; }
  .world[data-motion='off'] { height: auto !important; }
  .world[data-motion='off'] .stage { position: relative; min-height: 100svh; height: auto; }
  .world[data-motion='off'] .clip { display: none; }
  .world[data-motion='off'] .stop-image { display: none; }
  .world[data-motion='off'] .character { display: none; }
  .world[data-motion='off'] .particles { display: none; }
  .world[data-motion='off'] .stops { display: none; }
  .world[data-motion='off'] .static-dialogues { display: grid; gap: 1rem; padding: 1.5rem; background: #173b40; color: white; }
  .static-dialogues article { padding: 1rem 1.25rem; border: 1px solid rgb(255 255 255 / 45%); border-radius: .75rem; background: rgb(7 30 34 / 75%); }
  .static-dialogues h3 { margin: 0 0 .5rem; }
  .static-dialogues p { margin: .4rem 0; }
  @media (max-width: 640px) { .stops { right: .5rem; width: 2.25rem; height: min(64svh, 32rem); padding-block: 1.125rem; } .stops button { top: var(--stop-mobile-position); width: 2.25rem; height: 2.25rem; } .stops button::before { inset: .25rem .1rem; } .timeline-indicator { width: 2.9rem; } .copy { right: 3.25rem; } .character { right: 3rem; bottom: 31svh; max-width: calc(100% - 5rem); height: 40svh; } .stage[data-dialogue-visible='true'] .character { right: 2.5rem; bottom: 0; height: 64svh; } .dialogue { left: 1rem; bottom: 1rem; width: calc(100% - 4.5rem); padding: 1rem; } .dialogue-controls { gap: .45rem; } .dialogue-controls button { padding: .4rem .6rem; } .debug { display: none; } }
  @media (max-width: 640px), (pointer: coarse) { .world { height: var(--mobile-world-height); } }
  @media (pointer: coarse) { .stops button { top: var(--stop-mobile-position); } }
  @media (prefers-reduced-motion: reduce) { .clip, .stop-image, .character { transition: none; } }
</style>
