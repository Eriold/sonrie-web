---
import { tourSegments } from '../data/tour';
import { photoUrls, posterUrls, videoUrls } from '../data/media';
import { createTourTimeline } from '../scripts/timeline';

const timeline = createTourTimeline(tourSegments);
const stopSegments = timeline.segments.flatMap((segment, segmentIndex) => segment.stopUnits > 0 ? [{ segment, segmentIndex }] : []);
const isDev = import.meta.env.DEV;
---

<section class="world" data-world style={`height: ${100 * (timeline.totalUnits + 1)}svh`} aria-label="Recorrido visual de Sonríe">
  <div class="stage" data-stage>
    <div class="fallback" aria-hidden="true"></div>
    {timeline.segments.map((segment, index) => (
      <video
        class="clip"
        data-clip
        data-index={index}
        data-asset={segment.clipAsset}
        src={videoUrls[segment.clipAsset]}
        preload="none"
        muted
        playsinline
        aria-hidden="true"
        tabindex="-1"
      />
    ))}
    {timeline.segments.map((segment, index) => segment.stopPhotoAsset && (
      <img
        class="stop-image"
        data-poster
        data-index={index}
        data-asset={segment.clipAsset}
        src={posterUrls[segment.clipAsset]}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    ))}
    {timeline.segments.map((segment, index) => segment.stopPhotoAsset && (
      <img
        class="stop-image"
        data-photo
        data-index={index}
        data-asset={segment.stopPhotoAsset}
        src={photoUrls[segment.stopPhotoAsset]}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    ))}
    <div class="shade" aria-hidden="true"></div>
    {stopSegments.map(({ segment, segmentIndex }, stopIndex) => (
      <section
        class="stop"
        data-stop
        data-index={segmentIndex}
        data-stop-id={segment.stopId}
        aria-labelledby={`stop-title-${stopIndex + 1}`}
        hidden
      >
        <p class="stop-eyebrow">Parada del recorrido</p>
        <h3 id={`stop-title-${stopIndex + 1}`}>Parada {stopIndex + 1}</h3>
        <p>Contenido en preparación.</p>
      </section>
    ))}
    <div class="copy">
      <p class="eyebrow">Recorrido en preparación · {timeline.segments.length} tramos</p>
      <h2>Conoce Sonríe</h2>
      <p data-status role="status" aria-live="polite">Cargando el primer tramo…</p>
      <a href="#despues-del-recorrido">Saltar el recorrido</a>
    </div>
    <div class="counter" aria-hidden="true"><span data-counter>01</span> / {String(timeline.segments.length).padStart(2, '0')}</div>
    <nav class="stops" aria-label="Ir a una parada del recorrido">
      {stopSegments.map(({ segmentIndex }, stopIndex) => (
        <button type="button" data-goto-stop={segmentIndex} aria-label={`Ir a la parada ${stopIndex + 1}`}>
          {String(stopIndex + 1).padStart(2, '0')}
        </button>
      ))}
    </nav>
    {isDev && (
      <label class="mode-picker" data-mode-picker hidden>
        Fondo de esta parada
        <select data-mode-select>
          <option value="video-freeze">Video congelado</option>
          <option value="poster-image">Póster del video</option>
          <option value="high-res-image">Foto homónima</option>
        </select>
      </label>
    )}
    {isDev && <output class="debug" data-debug aria-label="Depuración del recorrido">Iniciando recorrido…</output>}
  </div>
</section>

<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>

<style>
  .world { position: relative; background: #173b40; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; color: white; background: #173b40; }
  .fallback, .clip, .stop-image, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fallback { background: radial-gradient(circle at 70% 30%, #337477, #173b40 70%); }
  .clip { object-fit: cover; opacity: 0; transition: opacity 180ms ease; }
  .clip.is-active, .clip.is-outgoing { opacity: 1; }
  .stop-image { object-fit: cover; object-position: center; opacity: 0; transition: opacity 180ms ease; pointer-events: none; }
  .stop-image.is-active, .stop-image.is-outgoing { opacity: 1; }
  .shade { z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgb(7 30 34 / 77%), transparent 80%), linear-gradient(0deg, rgb(7 30 34 / 65%), transparent 45%); }
  .stop { position: absolute; z-index: 2; top: clamp(5rem, 12vh, 8rem); left: clamp(1.5rem, 6vw, 6rem); max-width: min(26rem, calc(100% - 6rem)); padding: 1.25rem 1.5rem; border: 1px solid rgb(255 255 255 / 50%); border-radius: 1rem; background: rgb(7 30 34 / 82%); box-shadow: 0 1rem 2rem rgb(0 0 0 / 15%); }
  .stop[hidden] { display: none; }
  .stop-eyebrow { margin: 0 0 .5rem; font-size: .75rem; letter-spacing: .15em; text-transform: uppercase; }
  .stop h3 { margin: 0 0 .5rem; font-size: clamp(1.5rem, 4vw, 2.25rem); }
  .stop p:last-child { margin: 0; }
  .copy { position: absolute; z-index: 2; left: clamp(1.5rem, 6vw, 6rem); bottom: clamp(2.5rem, 9vh, 6rem); max-width: 34rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .15em; font-size: .75rem; }
  h2 { margin: .6rem 0; font-size: clamp(2.75rem, 7vw, 6rem); line-height: 1; }
  [data-status] { min-height: 1.5em; margin: 1.25rem 0; }
  a { display: inline-block; padding: .75rem 1rem; border: 1px solid currentColor; border-radius: 999px; text-underline-offset: .2em; }
  a:focus-visible { outline: 3px solid white; outline-offset: 4px; }
  .counter { position: absolute; z-index: 2; right: clamp(1.5rem, 6vw, 6rem); bottom: clamp(2.5rem, 9vh, 6rem); font-variant-numeric: tabular-nums; }
  .stops { position: absolute; z-index: 3; right: clamp(1rem, 3vw, 3rem); top: 50%; display: flex; flex-direction: column; gap: .5rem; transform: translateY(-50%); }
  .stops button { width: 2.75rem; height: 2.75rem; border: 1px solid rgb(255 255 255 / 75%); border-radius: 50%; background: rgb(7 30 34 / 65%); color: white; cursor: pointer; font-size: .8rem; font-variant-numeric: tabular-nums; }
  .stops button[aria-current='step'] { background: white; color: #173b40; }
  .stops button:focus-visible { outline: 3px solid white; outline-offset: 3px; }
  .debug { position: absolute; z-index: 3; left: 1rem; top: 1rem; max-width: calc(100% - 2rem); padding: .4rem .6rem; background: rgb(7 30 34 / 82%); color: white; font: .75rem/1.4 monospace; }
  .mode-picker { position: absolute; z-index: 4; top: 1rem; right: 1rem; padding: .4rem .6rem; background: rgb(7 30 34 / 82%); color: white; font: .75rem/1.4 sans-serif; }
  .mode-picker[hidden] { display: none; }
  .mode-picker select { display: block; margin-top: .25rem; padding: .25rem; border: 1px solid white; border-radius: .25rem; background: #173b40; color: white; }
  .mode-picker select:focus-visible { outline: 3px solid white; outline-offset: 3px; }
  .world[data-motion='off'] { height: auto !important; }
  .world[data-motion='off'] .stage { position: relative; min-height: 100svh; height: auto; }
  .world[data-motion='off'] .clip { display: none; }
  .world[data-motion='off'] .stop-image { display: none; }
  .world[data-motion='off'] .stops { display: none; }
  @media (max-width: 640px) { .stops { right: .5rem; gap: .25rem; } .stops button { width: 2.25rem; height: 2.25rem; } .copy { right: 3.25rem; } .debug { display: none; } }
  @media (prefers-reduced-motion: reduce) { .clip, .stop-image { transition: none; } }
</style>
